{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mastra-app",
  "main": "./src/worker.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "observability": {
    "logs": {
      "enabled": false
    }
  }
}
